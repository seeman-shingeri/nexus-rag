# ==============================================================================
# NEXUS SAFETY INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Network & Host
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Default: SQLite file for zero-dependency local runs
DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# PostgreSQL with pgvector for production deployments:
# DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_password@localhost:5432/nexus_db

# Storage Directories
STORAGE_DIR=./storage
EVIDENCE_DIR=./storage/evidence
DOCUMENTS_DIR=./storage/documents

# AI Model Strategy
# Options: "local" (deterministic rule-grounded responder) or "gemini"
LLM_PROVIDER=local
# Required only if LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Computer Vision & Camera Configuration
CAMERA_INDEX=0
VISION_CONFIDENCE_THRESHOLD=0.65
DEMO_MODE=true
MAX_PERSISTENCE_SECONDS=5
COOLDOWN_MINUTES=5

# Privacy & Evidence Retention
EVIDENCE_RETENTION_DAYS=30
AUTO_PURGE_ENABLED=true
MASK_SENSITIVE_REGIONS=false
